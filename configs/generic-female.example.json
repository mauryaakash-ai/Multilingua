{
  "timeout_seconds": 1800,
  "max_speech_speed": 1.25,
  "commands": {
    "asr": [
      "{project}/.venv-speech/bin/python",
      "{project}/adapters/asr.py",
      "--model",
      "small.en",
      "--device",
      "cpu"
    ],
    "translate": [
      "{project}/.venv-translation/bin/python",
      "{project}/adapters/translate.py",
      "--device",
      "cpu"
    ],
    "tts": [
      "{project}/.venv-voice/bin/python",
      "{project}/adapters/tts_parler.py"
    ],
    "lipsync": [
      "{python}",
      "{project}/adapters/lipsync_musetalk.py"
    ]
  },
  "tts": {
    "model": "ai4bharat/indic-parler-tts",
    "device": "cuda",
    "description": "Divya speaks in a mature female voice, delivering a formal speech clearly at a slightly fast pace with natural intonation and very little background noise."
  },
  "lipsync": {
    "repo": "${HOME}/MuseTalk",
    "python": "${HOME}/MuseTalk/.venv/bin/python",
    "batch_size": 2
  }
}
