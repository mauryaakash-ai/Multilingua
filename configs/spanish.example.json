{
  "timeout_seconds": 1800,
  "max_speech_speed": 1.25,
  "commands": {
    "asr": [
      "{project}/.venv-speech/bin/python",
      "{project}/adapters/asr.py",
      "--model",
      "small.en",
      "--device",
      "cpu"
    ],
    "translate": [
      "{project}/.venv-translation/bin/python",
      "{project}/adapters/translate_nllb.py",
      "--model",
      "{project}/models/nllb-200-distilled-600M"
    ],
    "tts": [
      "{project}/.venv-xtts/bin/python",
      "{project}/adapters/tts_xtts.py"
    ],
    "lipsync": [
      "{python}",
      "{project}/adapters/lipsync_musetalk.py"
    ]
  },
  "tts": {
    "model": "{project}/models/xtts-v2",
    "device": "cuda",
    "speaker": "Ana Florence",
    "language": "es"
  },
  "lipsync": {
    "repo": "${HOME}/MuseTalk",
    "python": "${HOME}/MuseTalk/.venv/bin/python",
    "batch_size": 2
  },
  "target_language": "es"
}
